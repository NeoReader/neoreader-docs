{
    "openapi": "3.1.0",
    "info": {
        "title": "NeoReader QR Code API",
        "version": "1.0.0",
        "summary": "Create, change and measure dynamic QR codes.",
        "description": "A free QR code generator API for dynamic QR codes. A dynamic code holds a short link, neoreader.com/q/SLUG, that redirects to a destination you can change at any time. Create, list, update and delete codes and read scan statistics. Scans are counted without storing IP addresses. The same codes can be managed by an AI assistant through the MCP server at https://neoreader.com/mcp.",
        "termsOfService": "https://neoreader.com/terms",
        "contact": {
            "name": "NeoReader",
            "url": "https://neoreader.com/contact"
        },
        "license": {
            "name": "NeoReader Terms",
            "url": "https://neoreader.com/terms"
        }
    },
    "externalDocs": {
        "description": "NeoReader developer documentation",
        "url": "https://neoreader.com/developers"
    },
    "servers": [
        {
            "url": "https://neoreader.com/api/v1"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "tags": [
        {
            "name": "Account"
        },
        {
            "name": "Codes"
        },
        {
            "name": "Stats"
        }
    ],
    "paths": {
        "/me": {
            "get": {
                "operationId": "getMe",
                "tags": [
                    "Account"
                ],
                "summary": "Get Your Account",
                "description": "Your name, email, plan, how many codes you have and how many you may have.",
                "responses": {
                    "200": {
                        "description": "Your account.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Me"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            }
        },
        "/codes": {
            "get": {
                "operationId": "listCodes",
                "tags": [
                    "Codes"
                ],
                "summary": "List Codes",
                "description": "A page of your codes, newest first.",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Search word, matched against title, slug and destination.",
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        }
                    },
                    {
                        "name": "folder",
                        "in": "query",
                        "description": "Only codes in this folder.",
                        "schema": {
                            "type": "string",
                            "maxLength": 60
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Only codes with this status.",
                        "schema": {
                            "$ref": "#/components/schemas/Status"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Codes per page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 25
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of codes.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CodePage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            },
            "post": {
                "operationId": "createCode",
                "tags": [
                    "Codes"
                ],
                "summary": "Create a Code",
                "description": "Creates a dynamic code. Title and destination are required. The destination must be a full http:// or https:// address, or a mailto: or tel: link. Links to another NeoReader short link and private network addresses are refused.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CodeInput"
                            },
                            "example": {
                                "title": "Spring menu",
                                "destination": "https://example.com/menu",
                                "folder": "Restaurant",
                                "utm": {
                                    "utm_source": "qr",
                                    "utm_medium": "print"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The code that was created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Code"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            }
        },
        "/codes/{slug}": {
            "parameters": [
                {
                    "name": "slug",
                    "in": "path",
                    "required": true,
                    "description": "The code’s slug, the last part of its short URL.",
                    "schema": {
                        "type": "string",
                        "example": "k7Xp2m"
                    }
                }
            ],
            "get": {
                "operationId": "getCode",
                "tags": [
                    "Codes"
                ],
                "summary": "Get a Code",
                "description": "One code. A slug that is not yours returns 404.",
                "responses": {
                    "200": {
                        "description": "The code.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Code"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            },
            "patch": {
                "operationId": "updateCode",
                "tags": [
                    "Codes"
                ],
                "summary": "Update a Code",
                "description": "Changes the fields you send and leaves the rest alone. The slug and short URL never change, so printed codes keep working. A blocked code cannot be turned back on.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CodeInput"
                            },
                            "example": {
                                "destination": "https://example.com/summer-menu",
                                "expires_at": "2026-12-31T23:59:00Z"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The code after the change.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Code"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            },
            "delete": {
                "operationId": "deleteCode",
                "tags": [
                    "Codes"
                ],
                "summary": "Delete a Code",
                "description": "Deletes the code and its scan history. This cannot be undone and the printed code stops working. Pause the code instead if you may need it again.",
                "responses": {
                    "204": {
                        "description": "The code was deleted."
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            }
        },
        "/codes/{slug}/stats": {
            "get": {
                "operationId": "getCodeStats",
                "tags": [
                    "Stats"
                ],
                "summary": "Get Scan Stats",
                "description": "Scan statistics for the last N days, today included: totals, a count for every day, and the top countries, devices, operating systems and browsers. Unique counts one visitor once per day.",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "description": "The code’s slug, the last part of its short URL.",
                        "schema": {
                            "type": "string",
                            "example": "k7Xp2m"
                        }
                    },
                    {
                        "name": "days",
                        "in": "query",
                        "description": "How many days back to count.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 365,
                            "default": 30
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Scan statistics.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Stats"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "403": {
                        "$ref": "#/components/responses/403"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    },
                    "429": {
                        "$ref": "#/components/responses/429"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "An API token made under Account, then API Tokens, on https://neoreader.com. Send it as Authorization: Bearer YOUR_TOKEN."
            }
        },
        "responses": {
            "401": {
                "description": "The token is missing, wrong or revoked.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "403": {
                "description": "The account is disabled.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "404": {
                "description": "No such code on your account.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "422": {
                "description": "A field is invalid, you reached your code limit, or you tried to turn a blocked code back on.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "429": {
                "description": "Too many requests. Wait for the seconds in the Retry-After header.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        },
        "schemas": {
            "Status": {
                "type": "string",
                "enum": [
                    "active",
                    "paused",
                    "blocked",
                    "expired",
                    "not_started",
                    "limit"
                ]
            },
            "Me": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "plan": {
                        "type": "string",
                        "example": "free"
                    },
                    "codes_count": {
                        "type": "integer"
                    },
                    "code_limit": {
                        "type": "integer",
                        "example": 250
                    }
                }
            },
            "Utm": {
                "type": "object",
                "properties": {
                    "utm_source": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "utm_medium": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "utm_campaign": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    }
                }
            },
            "Code": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string",
                        "example": "k7Xp2m"
                    },
                    "short_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://neoreader.com/q/k7Xp2m",
                        "description": "The address printed in the QR code."
                    },
                    "title": {
                        "type": "string"
                    },
                    "destination": {
                        "type": "string"
                    },
                    "folder": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "status": {
                        "$ref": "#/components/schemas/Status"
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "starts_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "scan_limit": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "has_password": {
                        "type": "boolean"
                    },
                    "utm": {
                        "$ref": "#/components/schemas/Utm"
                    },
                    "scans_count": {
                        "type": "integer"
                    },
                    "last_scanned_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "CodeInput": {
                "type": "object",
                "description": "Title and destination are required when creating a code.",
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 120,
                        "description": "Only you see it."
                    },
                    "destination": {
                        "type": "string",
                        "maxLength": 2000,
                        "description": "A full https:// or http:// address, or a mailto: or tel: link."
                    },
                    "folder": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 60
                    },
                    "is_active": {
                        "type": "boolean",
                        "description": "false pauses the code."
                    },
                    "starts_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "expires_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "Must be after starts_at."
                    },
                    "scan_limit": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1,
                        "maximum": 100000000
                    },
                    "password": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 4,
                        "maxLength": 100,
                        "writeOnly": true,
                        "description": "Responses show has_password instead. Send null to remove it."
                    },
                    "utm": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Utm"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "Added to the destination on every scan."
                    }
                }
            },
            "CodePage": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Code"
                        }
                    },
                    "links": {
                        "type": "object",
                        "properties": {
                            "first": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "last": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "prev": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "next": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "current_page": {
                                "type": "integer"
                            },
                            "per_page": {
                                "type": "integer"
                            },
                            "total": {
                                "type": "integer"
                            },
                            "last_page": {
                                "type": "integer"
                            }
                        }
                    }
                }
            },
            "Stats": {
                "type": "object",
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "days": {
                        "type": "integer"
                    },
                    "from": {
                        "type": "string",
                        "format": "date"
                    },
                    "to": {
                        "type": "string",
                        "format": "date"
                    },
                    "totals": {
                        "type": "object",
                        "properties": {
                            "scans": {
                                "type": "integer"
                            },
                            "unique": {
                                "type": "integer"
                            }
                        }
                    },
                    "all_time_scans": {
                        "type": "integer"
                    },
                    "daily": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "date": {
                                    "type": "string",
                                    "format": "date"
                                },
                                "scans": {
                                    "type": "integer"
                                },
                                "unique": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "countries": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "country": {
                                    "type": "string"
                                },
                                "scans": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "devices": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "device": {
                                    "type": "string"
                                },
                                "scans": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "os": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "os": {
                                    "type": "string"
                                },
                                "scans": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "browsers": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "browser": {
                                    "type": "string"
                                },
                                "scans": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "message"
                ]
            }
        }
    }
}
